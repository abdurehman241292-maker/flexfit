# MongoDB Atlas connection string (non-SRV format if you hit querySrv errors)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flexfit

# Session secret - any random long string
SESSION_SECRET=change_this_to_a_long_random_string

# Admin login (used to access /admin dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Email that RECEIVES the "new order" notifications (your inbox)
NOTIFY_EMAIL=you@example.com

# Gmail account used to SEND the notification (use an App Password, not your real Gmail password)
SMTP_EMAIL=your.sending.address@gmail.com
SMTP_PASSWORD=your_16_char_app_password

PORT=5000